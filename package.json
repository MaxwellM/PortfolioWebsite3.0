{
  "name": "react-resume-template",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "yarn compile && yarn next build",
    "clean": "rm -rf build-tsc .next",
    "compile": "yarn run -T tsc --build --verbose",
    "dev": "yarn compile && yarn next dev --turbopack",
    "lint": "yarn run -T prettier --write './src/**/*.{js,jsx,json,ts,tsx}' && eslint './src/**/*.{js,jsx,ts,tsx}' --fix --max-warnings=0",
    "start": "yarn next start",
    "sitemap": "yarn next-sitemap"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.0.18",
    "classnames": "^2.3.2",
    "next": "16.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf": "^10.1.0",
    "sharp": "^0.34.4",
    "ts-pattern": "^5.0.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.1.1",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.9",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.7",
    "@types/tailwindcss": "^3.1.0",
    "@types/webpack-env": "^1.18.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-module-resolver": "^1.5.0",
    "eslint-plugin-monorepo": "^0.3.2",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-memo": "^0.0.3",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "postcss": "^8.5.6",
    "postcss-nesting": "^13.0.2",
    "postcss-preset-env": "^10.6.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass": "^1.64.2",
    "sort-package-json": "^3.6.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "autoprefixer": "10.4.5",
    "@types/react": "19.2.0"
  }
}
